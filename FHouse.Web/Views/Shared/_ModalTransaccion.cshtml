<!-- Modal: Nueva Transacción (Pure High-Performance Component) -->
<div id="modal-nueva-transaccion"
     class="fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-md flex items-center justify-center p-4 transition-opacity duration-200"
     style="display: none;"
     onclick="if (event.target === this) cerrarModalTransaccion();">

    <div class="apple-modal w-full max-w-lg p-6 sm:p-8 text-left relative overflow-hidden"
         onclick="event.stopPropagation();">

        <!-- Close Button -->
        <button type="button" onclick="cerrarModalTransaccion()" class="absolute top-6 right-6 text-subtitle hover:text-title transition-colors">
            <i data-lucide="x" class="w-5 h-5"></i>
        </button>

        <h3 class="text-xl font-bold text-title tracking-tight mb-1">Registrar Movimiento</h3>
        <p class="text-xs text-subtitle mb-6">Asigna el ingreso o gasto a un negocio o cuenta específica.</p>

        <!-- Formulario con soporte AJAX (htmx) -->
        <form hx-post="@Url.Action("Crear", "Transaccion")" 
              hx-swap="none" 
              hx-indicator="#loading-spinner"
              id="form-nueva-transaccion">
            
            @Html.AntiForgeryToken()

            <!-- Selector Tipo (Egreso / Ingreso) Segmented Apple Control -->
            <input type="hidden" name="Tipo" id="modal-input-tipo" value="2" />
            <div class="grid grid-cols-2 p-1 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 mb-5">
                <button type="button" 
                        id="modal-btn-tipo-egreso"
                        onclick="seleccionarTipoTransaccion('2')" 
                        class="py-2.5 rounded-xl text-xs flex items-center justify-center gap-2 transition-all bg-[#ff3b30]/15 text-[#ff3b30] dark:text-[#ff453a] shadow-sm font-bold">
                    <i data-lucide="arrow-down-circle" class="w-4 h-4"></i>
                    <span>Egreso / Gasto</span>
                </button>
                <button type="button" 
                        id="modal-btn-tipo-ingreso"
                        onclick="seleccionarTipoTransaccion('1')" 
                        class="py-2.5 rounded-xl text-xs flex items-center justify-center gap-2 transition-all text-subtitle hover:text-title font-medium">
                    <i data-lucide="arrow-up-circle" class="w-4 h-4"></i>
                    <span>Ingreso</span>
                </button>
            </div>

            <!-- Monto & Moneda (DOP / USD) -->
            <div class="mb-4">
                <label class="block text-xs font-medium text-subtitle mb-1.5">Monto y Moneda</label>
                <div class="grid grid-cols-3 gap-3">
                    <div class="col-span-2 relative">
                        <span id="modal-label-moneda" class="absolute left-4 top-1/2 -translate-y-1/2 text-subtitle font-bold text-sm">RD$</span>
                        <input type="number" step="0.01" min="0.01" name="Monto" required placeholder="0.00" 
                               class="apple-input pl-14 text-lg font-bold" />
                    </div>
                    <div>
                        <select name="Moneda" id="modal-select-moneda" onchange="document.getElementById('modal-label-moneda').textContent = this.value === '2' ? '$' : 'RD$';" class="apple-select font-medium text-sm">
                            <option value="1">DOP (RD$)</option>
                            <option value="2">USD ($)</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Concepto -->
            <div class="mb-4">
                <label class="block text-xs font-medium text-subtitle mb-1.5">Concepto o Detalle</label>
                <input type="text" name="Concepto" required placeholder="Ej: Pago de nómina, Venta producto, Alquiler..." 
                       class="apple-input text-sm" />
            </div>

            <!-- Contenedor dinámico e interconectado de opciones (Fuentes, Cuentas, Categorías) -->
            <div id="modal-transaccion-campos-container"
                 hx-get="@Url.Action("OpcionesModal", "Transaccion")"
                 hx-trigger="load, openModalTransaccion from:body, fuenteCreada from:body, cuentaCreada from:body, categoriaCreada from:body"
                 hx-swap="innerHTML">
                @Html.Partial("_ModalTransaccionCampos")
            </div>

            <!-- Botones de Acción -->
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" onclick="cerrarModalTransaccion()" class="btn-apple-secondary text-xs">
                    Cancelar
                </button>
                <button type="submit" class="btn-apple-primary text-xs flex items-center gap-2">
                    <span id="loading-spinner" class="htmx-indicator animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full"></span>
                    <span>Guardar Registro</span>
                </button>
            </div>
        </form>
    </div>
</div>
