<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - F House</title>

    <!-- Anti-flicker Theme Initialization -->
    <script>
        (function () {
            try {
                const savedTheme = localStorage.getItem('fh-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                if (savedTheme === 'light') {
                    document.documentElement.classList.add('light');
                    document.documentElement.classList.remove('dark');
                } else {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.remove('light');
                }
            } catch (e) { }
        })();
    </script>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Display"', '"SF Pro Text"', 'Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- htmx & Alpine.js -->
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script defer src="https://unpkg.com/alpinejs@3.13.5/dist/cdn.min.js"></script>

    <!-- Master Apple Design Stylesheet -->
    <link rel="stylesheet" href="~/wwwroot/css/fhouse.custom.css?v=@DateTime.UtcNow.Ticks" />

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="~/wwwroot/img/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/wwwroot/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/wwwroot/img/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/wwwroot/img/apple-touch-icon.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
</head>
<body x-data="{ openModalTransaccion: false, openModalTransferencia: false, openUserDropdown: false }" 
      @@abrir-modal-transaccion.window="openModalTransaccion = true"
      @@cerrar-modal-transaccion.window="openModalTransaccion = false" 
      @@cerrar-modales.window="openModalTransaccion = false; openModalTransferencia = false; openUserDropdown = false">
    @{
        var currentCtrl = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
        var isAuth = Request.IsAuthenticated;
        var claimsIdentity = (User != null && User.Identity != null) ? User.Identity as System.Security.Claims.ClaimsIdentity : null;
        
        var claimNombre = claimsIdentity != null ? claimsIdentity.FindFirst("NombreCompleto") : null;
        var claimEmail = claimsIdentity != null ? claimsIdentity.FindFirst(System.Security.Claims.ClaimTypes.Email) : null;
        var claimRol = claimsIdentity != null ? claimsIdentity.FindFirst(System.Security.Claims.ClaimTypes.Role) : null;
        var claimFamilia = claimsIdentity != null ? claimsIdentity.FindFirst("FamiliaNombre") : null;

        var nombreUsuario = (Session["NombreCompleto"] != null && !string.IsNullOrWhiteSpace(Session["NombreCompleto"].ToString())) 
            ? Session["NombreCompleto"].ToString() 
            : (claimNombre != null ? claimNombre.Value : ((User != null && User.Identity != null) ? User.Identity.Name : "Esteban Gómez"));
            
        var emailUsuario = (Session["Email"] != null && !string.IsNullOrWhiteSpace(Session["Email"].ToString())) 
            ? Session["Email"].ToString() 
            : (claimEmail != null ? claimEmail.Value : ((User != null && User.Identity != null) ? User.Identity.Name : "admin@fhouse.com"));
            
        var rol = (Session["Rol"] != null && !string.IsNullOrWhiteSpace(Session["Rol"].ToString())) 
            ? Session["Rol"].ToString() 
            : (claimRol != null ? claimRol.Value : "Admin");
            
        var familiaNombre = (ViewBag.FamiliaNombreActual as string) ?? (Session["FamiliaNombre"] != null ? Session["FamiliaNombre"].ToString() : (claimFamilia != null ? claimFamilia.Value : "Mi Familia"));
        var iniciales = !string.IsNullOrWhiteSpace(nombreUsuario) && nombreUsuario.Trim().Length >= 2 ? nombreUsuario.Trim().Substring(0, 2).ToUpper() : (!string.IsNullOrWhiteSpace(nombreUsuario) ? nombreUsuario.Trim().ToUpper() : "FH");
        var isCatalogActive = currentCtrl == "Cuenta" || currentCtrl == "FuenteIngreso" || currentCtrl == "Categoria";
    }

    <!-- Top Apple Frosted Header -->
    <header class="apple-navbar">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
            
            <!-- Left: Brand Logo & Title -->
            <div class="flex items-center gap-3 flex-shrink-0">
                <a href="@(isAuth ? Url.Action("Index", "Dashboard") : Url.Action("Login", "Account"))" 
                   class="flex items-center gap-2.5 group text-decoration-none px-2.5 py-1 rounded-2xl transition-all duration-150 @(currentCtrl == "Dashboard" ? "bg-[#0071e3]/10 dark:bg-[#0071e3]/15" : "hover:bg-black/5 dark:hover:bg-white/5")" 
                   title="@(isAuth ? "F House - Dashboard Principal" : "F House - Iniciar Sesión")">
                    <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#0071e3] to-[#2997ff] flex items-center justify-center font-bold text-white text-xs shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform flex-shrink-0">
                        FH
                    </div>
                    <span class="font-bold text-base tracking-tight text-title whitespace-nowrap group-hover:text-[#0071e3] transition-colors">
                        F House
                    </span>
                </a>
            </div>

            <!-- Center: Navigation Menu -->
            @if (isAuth)
            {
                <nav class="hidden md:flex items-center gap-1 overflow-visible py-1">
                    <a href="@Url.Action("Index", "Transaccion")" class="nav-link @(currentCtrl == "Transaccion" ? "active" : "")">
                        <i data-lucide="arrow-left-right" class="w-3.5 h-3.5"></i>
                        <span>Transacciones</span>
                    </a>
                    <a href="@Url.Action("Index", "Presupuesto")" class="nav-link @(currentCtrl == "Presupuesto" ? "active" : "")">
                        <i data-lucide="pie-chart" class="w-3.5 h-3.5"></i>
                        <span>Presupuestos</span>
                    </a>
                    <a href="@Url.Action("Index", "Reporte")" class="nav-link @(currentCtrl == "Reporte" ? "active" : "")">
                        <i data-lucide="bar-chart-3" class="w-3.5 h-3.5"></i>
                        <span>Reportes</span>
                    </a>

                    <!-- Dropdown: Catálogos / Estructura Base -->
                    <div class="relative" x-data="{ openCatalogos: false }" @@click.outside="openCatalogos = false">
                        <button type="button" 
                                @@click="openCatalogos = !openCatalogos" 
                                class="nav-link flex items-center gap-1.5 @(isCatalogActive ? "active" : "")"
                                title="Catálogos y configuración de entidades base">
                            <i data-lucide="layers" class="w-3.5 h-3.5"></i>
                            <span>Catálogos</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 transition-transform duration-200" :class="openCatalogos ? 'rotate-180' : ''"></i>
                        </button>

                        <!-- Submenu Popover -->
                        <div x-show="openCatalogos" 
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 scale-95 -translate-y-2"
                             x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                             x-transition:leave-end="opacity-0 scale-95 -translate-y-2"
                             class="apple-modal absolute left-0 mt-2 w-72 p-2 shadow-2xl z-50 text-left border border-black/10 dark:border-white/10"
                             style="display: none;">
                            
                            <div class="px-3 py-2 text-[10px] font-bold text-subtitle uppercase tracking-wider border-b border-black/5 dark:border-white/5 mb-1">
                                Estructura y Entidades Base
                            </div>

                            <a href="@Url.Action("Index", "Cuenta")" 
                               class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-black/5 dark:hover:bg-white/5 transition-colors group @(currentCtrl == "Cuenta" ? "bg-[#0071e3]/10 dark:bg-[#0071e3]/15 font-semibold text-[#0071e3] dark:text-[#2997ff]" : "text-title")">
                                <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-[#0071e3] dark:text-[#2997ff] flex items-center justify-center flex-shrink-0 mt-0.5 group-hover:scale-105 transition-transform">
                                    <i data-lucide="credit-card" class="w-4 h-4"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-medium text-title group-hover:text-[#0071e3] transition-colors">Cuentas Financieras</div>
                                    <div class="text-[11px] text-subtitle leading-tight mt-0.5">Bancos, efectivo y cuentas de ahorro</div>
                                </div>
                            </a>

                            <a href="@Url.Action("Index", "FuenteIngreso")" 
                               class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-black/5 dark:hover:bg-white/5 transition-colors group @(currentCtrl == "FuenteIngreso" ? "bg-[#0071e3]/10 dark:bg-[#0071e3]/15 font-semibold text-[#0071e3] dark:text-[#2997ff]" : "text-title")">
                                <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5 group-hover:scale-105 transition-transform">
                                    <i data-lucide="briefcase" class="w-4 h-4"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-medium text-title group-hover:text-[#0071e3] transition-colors">Fuentes de Ingreso</div>
                                    <div class="text-[11px] text-subtitle leading-tight mt-0.5">Negocios, salarios y rentas</div>
                                </div>
                            </a>

                            <a href="@Url.Action("Index", "Categoria")" 
                               class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-black/5 dark:hover:bg-white/5 transition-colors group @(currentCtrl == "Categoria" ? "bg-[#0071e3]/10 dark:bg-[#0071e3]/15 font-semibold text-[#0071e3] dark:text-[#2997ff]" : "text-title")">
                                <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5 group-hover:scale-105 transition-transform">
                                    <i data-lucide="tag" class="w-4 h-4"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-medium text-title group-hover:text-[#0071e3] transition-colors">Categorías</div>
                                    <div class="text-[11px] text-subtitle leading-tight mt-0.5">Clasificación de ingresos y gastos</div>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- Miembros Familiares en Menú Principal -->
                    <a href="@Url.Action("Index", "Usuario")" class="nav-link @(currentCtrl == "Usuario" ? "active" : "")">
                        <i data-lucide="users" class="w-3.5 h-3.5"></i>
                        <span>Miembros</span>
                    </a>
                </nav>
            }

            <!-- Right: Actions & Profile -->
            <div class="flex items-center gap-2.5 flex-shrink-0">
                <!-- Theme Toggle Button -->
                <button type="button" onclick="alternarTema()" class="btn-theme-toggle" title="Alternar modo Claro / Oscuro">
                    <i id="icono-tema" data-lucide="sun" class="w-4 h-4"></i>
                </button>

                @if (isAuth)
                {
                    <!-- User Profile Dropdown Component -->
                    <div class="relative">
                        <button type="button" @@click="openUserDropdown = !openUserDropdown" class="flex items-center gap-2 focus:outline-none">
                            <div class="w-8 h-8 rounded-full bg-[#0071e3]/10 text-[#0071e3] dark:text-[#2997ff] border border-[#0071e3]/20 flex items-center justify-center text-xs font-bold hover:scale-105 transition-transform flex-shrink-0">
                                @iniciales
                            </div>
                        </button>

                        <!-- Dropdown Menu -->
                        <div x-show="openUserDropdown" 
                             @@click.outside="openUserDropdown = false"
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 scale-95 -translate-y-2"
                             x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                             x-transition:leave-end="opacity-0 scale-95 -translate-y-2"
                             class="apple-modal absolute right-0 mt-2 w-64 p-3 shadow-2xl z-50 text-left border border-black/10 dark:border-white/10"
                             style="display: none;">
                            
                            <div class="p-3 border-b border-black/5 dark:border-white/5 mb-2">
                                <div class="font-bold text-sm text-title">@nombreUsuario</div>
                                <div class="text-[11px] text-subtitle truncate">@emailUsuario</div>
                                <div class="flex items-center gap-2 mt-2">
                                    <span class="apple-badge bg-[#0071e3]/15 text-[#0071e3] dark:text-[#2997ff] text-[10px]">@rol</span>
                                    <span class="text-[11px] text-muted-app">@familiaNombre</span>
                                </div>
                            </div>

                            <div class="space-y-1 text-xs">
                                <a href="@Url.Action("Perfil", "Account")" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-title hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                                    <i data-lucide="user" class="w-4 h-4 text-subtitle"></i>
                                    <span>Mi Perfil</span>
                                </a>
                                <a href="@Url.Action("Index", "Usuario")" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-title hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                                    <i data-lucide="users" class="w-4 h-4 text-subtitle"></i>
                                    <span>Miembros del Hogar</span>
                                </a>
                                <a href="@Url.Action("Index", "Configuracion")" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-title hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                                    <i data-lucide="shield" class="w-4 h-4 text-subtitle"></i>
                                    <span>Seguridad y Auditoría</span>
                                </a>
                            </div>

                            <div class="pt-2 mt-2 border-t border-black/5 dark:border-white/5">
                                <a href="@Url.Action("Logout", "Account")" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-rose-500 hover:bg-rose-500/10 transition-colors text-xs font-semibold">
                                    <i data-lucide="log-out" class="w-4 h-4"></i>
                                    <span>Cerrar Sesión</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="btn-apple-secondary text-xs">
                        <span>Iniciar Sesión</span>
                    </a>
                    <a href="@Url.Action("Register", "Account")" class="btn-apple-primary text-xs">
                        <span>Crear Cuenta</span>
                    </a>
                }
            </div>
        </div>

        <!-- Mobile Scrollable Navigation Bar (Only for Auth users) -->
        @if (isAuth)
        {
            <div class="md:hidden border-t border-black/5 dark:border-white/5 px-4 py-2 flex items-center gap-1 overflow-x-auto no-scrollbar">
                <a href="@Url.Action("Index", "Dashboard")" class="nav-link text-xs @(currentCtrl == "Dashboard" ? "active" : "")">Dashboard</a>
                <a href="@Url.Action("Index", "Transaccion")" class="nav-link text-xs @(currentCtrl == "Transaccion" ? "active" : "")">Transacciones</a>
                <a href="@Url.Action("Index", "Presupuesto")" class="nav-link text-xs @(currentCtrl == "Presupuesto" ? "active" : "")">Presupuestos</a>
                <a href="@Url.Action("Index", "Reporte")" class="nav-link text-xs @(currentCtrl == "Reporte" ? "active" : "")">Reportes</a>
                <span class="text-black/20 dark:text-white/20 mx-0.5">•</span>
                <a href="@Url.Action("Index", "Cuenta")" class="nav-link text-xs @(currentCtrl == "Cuenta" ? "active" : "")">Cuentas</a>
                <a href="@Url.Action("Index", "FuenteIngreso")" class="nav-link text-xs @(currentCtrl == "FuenteIngreso" ? "active" : "")">Fuentes</a>
                <a href="@Url.Action("Index", "Categoria")" class="nav-link text-xs @(currentCtrl == "Categoria" ? "active" : "")">Categorías</a>
                <a href="@Url.Action("Index", "Usuario")" class="nav-link text-xs @(currentCtrl == "Usuario" ? "active" : "")">Miembros</a>
            </div>
        }
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["Exito"] != null)
        {
            <div class="mb-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm flex items-center gap-3 shadow-sm">
                <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0"></i>
                <span>@TempData["Exito"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-sm flex items-center gap-3 shadow-sm">
                <i data-lucide="alert-triangle" class="w-5 h-5 flex-shrink-0"></i>
                <div>@Html.Raw(TempData["Error"])</div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Global Modal: Nueva Transacción (Only for Auth) -->
    @if (isAuth)
    {
        @Html.Partial("_ModalTransaccion")
    }

    <!-- Footer -->
    <footer class="border-t border-black/5 dark:border-white/5 py-6 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-subtitle gap-3">
            <div class="flex items-center gap-2">
                <span class="font-semibold text-title">F House (FH)</span>
                <span>•</span>
                <span>Sistema Familiar de Gestión Financiera</span>
            </div>
            <div>
                Monedas soportadas: <strong class="font-semibold text-title">RD$ DOP</strong> y <strong class="font-semibold text-title">$ USD</strong>
            </div>
        </div>
    </footer>

    <!-- App Script -->
    <script src="~/wwwroot/js/fhouse.app.js"></script>
    @if (isAuth)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof inicializarAutoLogout === 'function') {
                    inicializarAutoLogout(5);
                }
            });
        </script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>
