@model IEnumerable<FHouse.Services.DTOs.CuentaDetalleDto>
@{
    ViewBag.Title = "Cuentas y Efectivo";
}

<div class="space-y-8" x-data="{ 
    openModalCuenta: false, 
    openModalTransferencia: false,
    openModalEditarCuenta: false,
    filtroEstado: 'todas',
    cuentaEdit: { id: 0, nombre: '', institucionFinanciera: '', numeroCuenta: '', tipo: '2', moneda: '1', fuenteIngresoId: '', activo: true }
}">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-title">Cuentas y Efectivo</h1>
            <p class="text-sm text-subtitle mt-1">Gestión integral de cuentas corrientes, ahorros, tarjetas y cajas chicas.</p>
        </div>
        <div class="flex items-center gap-3 flex-shrink-0 flex-wrap">
            <!-- Filter tabs -->
            <div class="inline-flex p-1 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 text-xs">
                <button type="button" x-on:click="filtroEstado = 'todas'" :class="filtroEstado === 'todas' ? 'bg-white dark:bg-[#1c1c1e] text-title shadow-sm font-semibold' : 'text-subtitle hover:text-title'" class="px-3 py-1 rounded-lg transition-all">
                    Todas
                </button>
                <button type="button" x-on:click="filtroEstado = 'activas'" :class="filtroEstado === 'activas' ? 'bg-white dark:bg-[#1c1c1e] text-title shadow-sm font-semibold' : 'text-subtitle hover:text-title'" class="px-3 py-1 rounded-lg transition-all">
                    Activas
                </button>
                <button type="button" x-on:click="filtroEstado = 'inactivas'" :class="filtroEstado === 'inactivas' ? 'bg-white dark:bg-[#1c1c1e] text-title shadow-sm font-semibold' : 'text-subtitle hover:text-title'" class="px-3 py-1 rounded-lg transition-all">
                    Inhabilitadas
                </button>
            </div>
            <button type="button" x-on:click="openModalTransferencia = true" class="btn-apple-secondary">
                <i data-lucide="arrow-left-right" class="w-4 h-4 text-[#0071e3] dark:text-[#2997ff]"></i>
                <span>Transferir</span>
            </button>
            <button type="button" x-on:click="openModalCuenta = true" class="btn-apple-primary">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Nueva Cuenta</span>
            </button>
        </div>
    </div>

    <!-- Cards Grid / Empty State -->
    @if (Model == null || !Model.Any())
    {
        <!-- Apple Wallet Style Empty State Hero -->
        <div class="apple-card p-8 sm:p-12 text-center max-w-3xl mx-auto relative overflow-hidden">
            <!-- Background Glow Effect -->
            <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Stylized Apple Card Preview -->
            <div class="w-72 h-44 mx-auto mb-8 apple-wallet-card flex flex-col justify-between text-left shadow-2xl relative border border-white/20">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-blue-500"></div>
                        <span class="text-[11px] font-semibold tracking-wider text-subtitle uppercase">Banco / Caja</span>
                    </div>
                    <span class="apple-badge badge-neutral text-[10px]">DOP / USD</span>
                </div>
                <div>
                    <div class="text-xs text-subtitle">Saldo Disponible</div>
                    <div class="text-2xl font-extrabold text-title tracking-tight mt-0.5">RD$ 0.00</div>
                </div>
                <div class="flex items-center justify-between text-[11px] text-muted-app font-mono">
                    <span>•••• •••• •••• 0000</span>
                    <i data-lucide="credit-card" class="w-4 h-4 text-subtitle"></i>
                </div>
            </div>

            <!-- Copy & Call to Action -->
            <h2 class="text-xl font-bold text-title tracking-tight mb-2">Comienza organizando tus cuentas</h2>
            <p class="text-sm text-subtitle max-w-md mx-auto mb-6">
                Registra tus cuentas bancarias, tarjetas o cajas de efectivo en Pesos Dominicanos (RD$) o Dólares ($) para conciliar y dar seguimiento a tus fondos.
            </p>

            <button type="button" x-on:click="openModalCuenta = true" class="btn-apple-primary px-6 py-2.5 text-sm">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Crear Mi Primera Cuenta</span>
            </button>
        </div>
    }
    else
    {
        <!-- Grid of Apple Wallet Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var c in Model)
            {
                <div x-show="filtroEstado === 'todas' || (filtroEstado === 'activas' && @(c.Activo ? "true" : "false")) || (filtroEstado === 'inactivas' && @(!c.Activo ? "true" : "false"))"
                     class="apple-wallet-card flex flex-col justify-between group @(!c.Activo ? "opacity-75 grayscale-[25%]" : "")">
                    <!-- Top Info -->
                    <div>
                        <div class="flex items-center justify-between gap-3 mb-4 min-w-0">
                            <div class="flex items-center gap-2.5 min-w-0 flex-1">
                                <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center flex-shrink-0 @(!c.Activo ? "opacity-50" : "")">
                                    <i data-lucide="landmark" class="w-4 h-4"></i>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h3 class="font-bold text-base text-title tracking-tight truncate" title="@c.Nombre">@c.Nombre</h3>
                                    <span class="text-[11px] font-semibold text-subtitle uppercase tracking-wider block truncate" title="@(string.IsNullOrEmpty(c.InstitucionFinanciera) ? "Entidad Financiera" : c.InstitucionFinanciera)">
                                        @(string.IsNullOrEmpty(c.InstitucionFinanciera) ? "Entidad Financiera" : c.InstitucionFinanciera)
                                    </span>
                                </div>
                            </div>
                            <div class="flex items-center gap-1.5 flex-shrink-0">
                                @if (c.Activo)
                                {
                                    <span class="apple-badge @(c.Moneda == FHouse.Core.Enums.Moneda.USD ? "bg-purple-500/15 text-purple-400 border border-purple-500/30" : "bg-blue-500/15 text-blue-400 border border-blue-500/30") font-bold flex-shrink-0">
                                        @c.Moneda
                                    </span>
                                }
                                else
                                {
                                    <span class="apple-badge bg-amber-500/15 text-amber-500 border border-amber-500/30 text-[10px] uppercase font-semibold flex-shrink-0">Inhabilitada</span>
                                }

                                <button type="button" 
                                        x-on:click="cuentaEdit = { id: @c.Id, nombre: '@HttpUtility.JavaScriptStringEncode(c.Nombre)', institucionFinanciera: '@HttpUtility.JavaScriptStringEncode(c.InstitucionFinanciera != null ? c.InstitucionFinanciera : "")', numeroCuenta: '@HttpUtility.JavaScriptStringEncode(c.NumeroCuenta != null ? c.NumeroCuenta : "")', tipo: '@((int)c.Tipo)', moneda: '@((int)c.Moneda)', fuenteIngresoId: '@(c.FuenteIngresoId.HasValue ? c.FuenteIngresoId.Value.ToString() : "")', activo: @(c.Activo ? "true" : "false") }; openModalEditarCuenta = true;" 
                                        class="p-1.5 rounded-lg text-subtitle hover:text-[#0071e3] hover:bg-black/5 dark:hover:bg-white/5 transition-all flex-shrink-0"
                                        title="Editar Cuenta">
                                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>

                        <div class="flex items-center justify-between text-xs text-muted-app font-mono mb-6">
                            <span>@(string.IsNullOrEmpty(c.NumeroCuenta) ? "•••• •••• •••• ••••" : c.NumeroCuenta)</span>
                            @if (!string.IsNullOrEmpty(c.NombreFuenteIngreso))
                            {
                                <span class="text-[10px] font-sans font-medium px-2 py-0.5 rounded bg-black/5 dark:bg-white/5 text-subtitle truncate max-w-[120px]" title="Vinculada a @c.NombreFuenteIngreso">
                                    @c.NombreFuenteIngreso
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Bottom Balance & Actions -->
                    <div class="pt-4 border-t border-black/5 dark:border-white/5 flex items-end justify-between">
                        <div>
                            <span class="block text-[11px] text-subtitle uppercase font-medium">Saldo Actual</span>
                            <span class="text-2xl font-extrabold text-title tracking-tight">
                                @(c.Moneda == FHouse.Core.Enums.Moneda.USD ? "$" : "RD$") @c.SaldoActual.ToString("N2")
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            @if (!c.Activo)
                            {
                                <form method="post" action="@Url.Action("Eliminar", "Cuenta", new { id = c.Id })" class="inline" onsubmit="return confirm('¿Deseas eliminar permanentemente esta cuenta? Si tiene movimientos vinculados, será inhabilitada.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-apple-secondary text-xs text-rose-500 hover:text-rose-600 font-medium" title="Eliminar permanentemente">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5 mr-1 inline"></i>
                                        <span>Eliminar</span>
                                    </button>
                                </form>
                                <form method="post" action="@Url.Action("Habilitar", "Cuenta", new { id = c.Id })" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-apple-secondary text-xs text-emerald-500 hover:text-emerald-600 font-medium">
                                        <i data-lucide="check-circle" class="w-3.5 h-3.5 mr-1 inline"></i>
                                        <span>Habilitar</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-xs text-subtitle capitalize font-medium">@c.Tipo</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Modal: Nueva Cuenta -->
    <div x-show="openModalCuenta" 
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-md flex items-center justify-center p-4" 
         style="display: none;">
        <div x-on:click.outside="openModalCuenta = false" class="apple-modal w-full max-w-md p-6 sm:p-8 text-left relative">
            <button type="button" x-on:click="openModalCuenta = false" class="absolute top-6 right-6 text-subtitle hover:text-title">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <h3 class="text-xl font-bold text-title tracking-tight mb-1">Nueva Cuenta / Caja</h3>
            <p class="text-xs text-subtitle mb-6">Registra una cuenta bancaria, tarjeta o caja de efectivo.</p>

            <form method="post" action="@Url.Action("Crear", "Cuenta")">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="block text-xs font-medium text-subtitle mb-1.5">Nombre de la Cuenta</label>
                    <input type="text" name="Nombre" required placeholder="Ej: Cuenta Nómina Banreservas, Caja Chica..." 
                           class="apple-input" />
                </div>

                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-medium text-subtitle mb-1.5">Banco / Entidad</label>
                        <input type="text" name="InstitucionFinanciera" placeholder="Ej: Popular, BHD..." 
                               class="apple-input" />
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-subtitle mb-1.5">Moneda</label>
                        <select name="Moneda" class="apple-select">
                            <option value="1">DOP (RD$)</option>
                            <option value="2">USD ($)</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-medium text-subtitle mb-1.5">Número de Cuenta / Identificador (Opcional)</label>
                    <input type="text" name="NumeroCuenta" placeholder="Ej: **** 4589" 
                           class="apple-input font-mono" />
                </div>

                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-medium text-subtitle mb-1.5">Tipo</label>
                        <select name="Tipo" class="apple-select">
                            <option value="1">Corriente</option>
                            <option value="2" selected>Ahorro</option>
                            <option value="3">Efectivo</option>
                            <option value="4">Tarjeta de Crédito</option>
                            <option value="5">Billetera Digital</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-subtitle mb-1.5">Saldo Inicial</label>
                        <input type="number" step="0.01" name="SaldoInicial" value="0.00" 
                               class="apple-input font-bold" />
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-medium text-subtitle mb-1.5">Fuente / Negocio Asociado (Opcional)</label>
                    <select name="FuenteIngresoId" class="apple-select">
                        <option value="">-- Cuenta General del Hogar --</option>
                        @if (ViewBag.Fuentes != null)
                        {
                            foreach (var f in ((IEnumerable<FHouse.Services.DTOs.FuenteIngresoDetalleDto>)ViewBag.Fuentes).Where(x => x.Activo))
                            {
                                <option value="@f.Id">@f.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" x-on:click="openModalCuenta = false" class="btn-apple-secondary text-xs">Cancelar</button>
                    <button type="submit" class="btn-apple-primary text-xs">Crear Cuenta</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Editar Cuenta -->
    <div x-show="openModalEditarCuenta" 
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-md flex items-center justify-center p-4" 
         style="display: none;">
        <div x-on:click.outside="openModalEditarCuenta = false" class="apple-modal w-full max-w-md p-6 sm:p-8 text-left relative">
            <button type="button" x-on:click="openModalEditarCuenta = false" class="absolute top-6 right-6 text-subtitle hover:text-title">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <h3 class="text-xl font-bold text-title tracking-tight mb-1">Actualizar Cuenta</h3>
            <p class="text-xs text-subtitle mb-6">Modifica los datos, tipo o entidad de esta cuenta bancaria o caja.</p>

            <form method="post" :action="'@Url.Action("Actualizar", "Cuenta")/' + cuentaEdit.id">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="block text-xs font-medium text-subtitle mb-1.5">Nombre de la Cuenta</label>
                    <input type="text" name="Nombre" x-model="cuentaEdit.nombre" required placeholder="Ej: Cuenta Nómina" 
                           class="apple-input text-sm" />
                </div>

                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-medium text-subtitle mb-1.5">Banco / Entidad</label>
                        <input type="text" name="InstitucionFinanciera" x-model="cuentaEdit.institucionFinanciera" placeholder="Ej: Popular, BHD..." 
                               class="apple-input text-sm" />
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-subtitle mb-1.5">Moneda</label>
                        <select name="Moneda" x-model="cuentaEdit.moneda" class="apple-select text-sm">
                            <option value="1">DOP (RD$)</option>
                            <option value="2">USD ($)</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-medium text-subtitle mb-1.5">Tipo</label>
                        <select name="Tipo" x-model="cuentaEdit.tipo" class="apple-select text-sm">
                            <option value="1">Corriente</option>
                            <option value="2">Ahorro</option>
                            <option value="3">Efectivo</option>
                            <option value="4">Tarjeta de Crédito</option>
                            <option value="5">Billetera Digital</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-subtitle mb-1.5">Número de Cuenta</label>
                        <input type="text" name="NumeroCuenta" x-model="cuentaEdit.numeroCuenta" placeholder="Ej: **** 4589" 
                               class="apple-input font-mono text-sm" />
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-medium text-subtitle mb-1.5">Fuente / Negocio Asociado (Opcional)</label>
                    <select name="FuenteIngresoId" x-model="cuentaEdit.fuenteIngresoId" class="apple-select text-sm">
                        <option value="">-- Cuenta General del Hogar --</option>
                        @if (ViewBag.Fuentes != null)
                        {
                            foreach (var f in ((IEnumerable<FHouse.Services.DTOs.FuenteIngresoDetalleDto>)ViewBag.Fuentes).Where(x => x.Activo))
                            {
                                <option value="@f.Id">@f.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <div class="p-3 mb-4 rounded-xl bg-black/5 dark:bg-white/5 text-[11px] text-subtitle flex items-start gap-2">
                    <i data-lucide="shield-check" class="w-4 h-4 text-[#0071e3] flex-shrink-0 mt-0.5"></i>
                    <span><strong>Protección de relaciones:</strong> Si esta cuenta posee movimientos o transferencias vinculadas, el sistema la inhabilitará para proteger el historial financiero.</span>
                </div>

                <div class="flex items-center justify-between pt-2">
                    <button type="button" 
                            x-on:click="if (confirm('¿Deseas dar de baja o eliminar esta cuenta? Si tiene movimientos vinculados, será inhabilitada automáticamente.')) { $refs.formEliminarCuenta.submit(); }" 
                            class="text-xs text-rose-500 hover:text-rose-600 font-medium flex items-center gap-1">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        <span>Dar de baja / Eliminar</span>
                    </button>

                    <div class="flex items-center gap-3">
                        <button type="button" x-on:click="openModalEditarCuenta = false" class="btn-apple-secondary text-xs">Cancelar</button>
                        <button type="submit" class="btn-apple-primary text-xs">Guardar Cambios</button>
                    </div>
                </div>
            </form>

            <form x-ref="formEliminarCuenta" method="post" :action="'@Url.Action("Eliminar", "Cuenta")/' + cuentaEdit.id" style="display: none;">
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>

    <!-- Modal: Transferencia entre Cuentas -->
    <div x-show="openModalTransferencia" 
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-md flex items-center justify-center p-4" 
         style="display: none;">
        <div x-on:click.outside="openModalTransferencia = false" class="apple-modal w-full max-w-md p-6 sm:p-8 text-left relative">
            <button type="button" x-on:click="openModalTransferencia = false" class="absolute top-6 right-6 text-subtitle hover:text-title">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <h3 class="text-xl font-bold text-title tracking-tight mb-1">Transferencia Interna</h3>
            <p class="text-xs text-subtitle mb-6">Mover fondos entre cuentas del hogar o negocios.</p>

            <form method="post" action="@Url.Action("Transferir", "Cuenta")">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="block text-xs font-medium text-subtitle mb-1.5">Cuenta de Origen (Salida)</label>
                    <select name="CuentaOrigenId" required class="apple-select">
                        <option value="">-- Selecciona cuenta de débito --</option>
                        @if (Model != null)
                        {
                            foreach (var c in Model.Where(x => x.Activo))
                            {
                                <option value="@c.Id">@c.Nombre (@c.Moneda - Saldo: @c.SaldoActual.ToString("N2"))</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-medium text-subtitle mb-1.5">Cuenta de Destino (Entrada)</label>
                    <select name="CuentaDestinoId" required class="apple-select">
                        <option value="">-- Selecciona cuenta de crédito --</option>
                        @if (Model != null)
                        {
                            foreach (var c in Model.Where(x => x.Activo))
                            {
                                <option value="@c.Id">@c.Nombre (@c.Moneda)</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-medium text-subtitle mb-1.5">Monto a Transferir</label>
                    <input type="number" step="0.01" min="0.01" name="Monto" required placeholder="0.00" 
                           class="apple-input text-lg font-bold" />
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-medium text-subtitle mb-1.5">Comentario / Motivo</label>
                    <input type="text" name="Comentario" placeholder="Ej: Pago de tarjeta, fondeo de caja..." 
                           class="apple-input" />
                </div>

                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" x-on:click="openModalTransferencia = false" class="btn-apple-secondary text-xs">Cancelar</button>
                    <button type="submit" class="btn-apple-primary text-xs">Ejecutar Transferencia</button>
                </div>
            </form>
        </div>
    </div>
</div>
